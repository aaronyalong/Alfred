# Copy to .env and fill in. .env is git-ignored; never commit real keys.

# Anthropic API key: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Model used for question generation
ALFRED_MODEL=claude-opus-5-5

# The web app's database. This default matches `docker compose up -d db`.
DATABASE_URL=postgresql+psycopg://alfred:alfred@localhost:5432/alfred
